// Cloudflare Worker + Static Assets: satu project untuk website (folder public/), API (/api/*), dan cron push.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hadzmi-website-utama",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cek pengingat tiap menit lalu kirim push
  "triggers": { "crons": ["* * * * *"] },
  // KV dibuat otomatis oleh wrangler saat deploy pertama
  "kv_namespaces": [{ "binding": "HUB_KV" }],
  // === CLOUDFLARE R2 (10 GB gratis, aktif) — bucket dibuat otomatis saat deploy ===
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "hadzmi-hub-files" }
  ],
  // === NEXO GAMES: server realtime (chat + game) — Durable Object SQLite, termasuk paket gratis ===
  "durable_objects": {
    "bindings": [{ "name": "NEXO", "class_name": "NexoHub" }]
  },
  "migrations": [
    { "tag": "nexo-v1", "new_sqlite_classes": ["NexoHub"] }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "web-hadzmi-new"
  },
  // Variabel yang diisi di Dashboard (Settings → Variables and Secrets) tidak dihapus saat deploy:
  //   OWNER_UID      = UID akun Firebase-mu
  //   VAPID_SUBJECT  = mailto:emailkamu@gmail.com
  //   DRIVE_SCRIPT_URL (Text)   = URL Web App Apps Script (apps-script/Code.gs)
  //   DRIVE_SECRET     (Secret) = kata rahasia yang sama dengan Script Property SECRET
  "keep_vars": true,
  "observability": { "enabled": true }
}
