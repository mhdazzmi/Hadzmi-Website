{
  "rules": {
    ".read": false,
    ".write": false,
    "hadzmi_assistant_data": {
      ".read": "auth != null && auth.uid === 'GANTI_DENGAN_UID_KAMU'",
      ".write": "auth != null && auth.uid === 'GANTI_DENGAN_UID_KAMU'"
    },
    "hadzmi_healthcare_data": {
      ".read": "auth != null && auth.uid === 'GANTI_DENGAN_UID_KAMU'",
      ".write": "auth != null && auth.uid === 'GANTI_DENGAN_UID_KAMU'"
    },
    "hadzmi_social_data": {
      ".read": true,
      ".write": true,
      "$col": {
        ".validate": "$col.matches(/^(clients|posts|media|ideas|templates|reports|invoices|tasks|settings)$/)"
      }
    },
    "hadzmi_lekat_data": {
      ".read": true,
      ".write": true,
      "$store": {
        ".validate": "$store.matches(/^(notes|cards|decks|presets|notetypes|revlog|media|meta)$/)",
        ".indexOn": [
          "t"
        ],
        "$id": {
          ".validate": "newData.hasChildren(['mod', 'j']) && newData.child('j').isString() && newData.child('j').val().length < 200000"
        }
      }
    }
  }
}
